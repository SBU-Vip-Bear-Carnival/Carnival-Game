# Copy to tools/.env (gitignored) and set for your machine.
# Find your port with:  arduino-cli board list

# macOS  e.g. /dev/cu.usbmodem14201
# Linux  e.g. /dev/ttyACM0
# Windows e.g. COM3
SERIAL_PORT=/dev/cu.usbmodem14201

# The board is NOT set here. It comes from the `mega` profile in
# firmware/carnival/sketch.yaml, so that the pinned core and library versions
# travel with it. Change it there, not here.
